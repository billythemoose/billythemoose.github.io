---
import Icon from '@/components/Icon.astro';
import { faBuildingColumns } from '@fortawesome/free-solid-svg-icons';

interface Props {
  contents: { title: string; institution?: string; year: string; description: string[] }[];
}

const { contents } = Astro.props;
---

<ul class="font-light">
  {contents.map((item) => (
    <li class="border-b border-divider px-5 py-3 last:border-b-0">
      <div class="flex flex-col md:flex-row">
        <div class="md:w-[110px] md:shrink-0 md:text-center">
          <span class="inline-block min-w-[75px] rounded-[0.125rem] bg-accent px-1 py-1 text-center text-[75%] leading-none font-bold whitespace-nowrap text-card uppercase">
            {item.year}
          </span>
        </div>
        <div class="mt-2 md:mt-0 md:ml-2">
          <h6 class="ml-1 font-bold">{item.title}</h6>
          {item.institution && (
            <p class="mb-4 ml-1 flex items-start gap-1.5">
              <Icon icon={faBuildingColumns} class="mt-[0.2em] text-[0.95rem] text-accent" />
              <span>{item.institution}</span>
            </p>
          )}
          {item.description.length > 0 && (
            <ul class="list-[circle] pl-4">
              {item.description.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </li>
  ))}
</ul>
