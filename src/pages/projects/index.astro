---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const projects = (
  await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => a.data.importance - b.data.importance);
const categories = [...new Set(projects.map((project) => project.data.category ?? 'other'))];
---

<BaseLayout title="projects" description="Projects and demos.">
  <div class="border-b border-divider pt-8 pb-12 text-center">
    <h1 class="text-[5rem] text-accent">projects</h1>
    <h2>things I've built</h2>
  </div>

  {projects.length === 0 && <p>Nothing here yet.</p>}

  {categories.map((category) => (
    <section>
      {categories.length > 1 && (
        <h2 class="mt-8 mb-4 border-b border-divider pt-2 text-right text-divider">{category}</h2>
      )}
      <div
        class:list={[
          'grid gap-4 sm:grid-cols-2 md:grid-cols-3',
          { 'mt-8': categories.length === 1 },
        ]}
      >
        {projects
          .filter((project) => (project.data.category ?? 'other') === category)
          .map((project) => (
            <a
              href={`/projects/${project.id}/`}
              class="group block rounded border border-divider bg-card p-4 shadow-card hover:no-underline"
            >
              <h3 class="text-xl text-fg group-hover:text-accent">{project.data.title}</h3>
              {project.data.description && (
                <p class="mb-0 text-sm text-muted">{project.data.description}</p>
              )}
            </a>
          ))}
      </div>
    </section>
  ))}
</BaseLayout>
